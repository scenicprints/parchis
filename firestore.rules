// ═══════════════════════════════════════════════════════════════════════
//  Firestore rules for the foos-6ecf3 project.
//
//  This is what is actually published, as of 2026-07-29. Parchís reuses the
//  project the foos league already runs in, so it only adds one match block
//  alongside the league's own.
//
//  Console → Firestore Database → Rules. Old versions are kept in the
//  panel on the left of that screen, so a bad publish is one click to undo.
// ═══════════════════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The foos league.
    match /leagues/{leagueId}/{rest=**} {
      allow read, write: if request.auth != null;
    }

    // Parchís: the "table" and "game" documents.
    match /parchis/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
